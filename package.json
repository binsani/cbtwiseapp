{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "cbtwise-desktop",
    "version": "1.0.0",
    "description": "CBTwise AI-Powered CBT Prep Desktop Platform",
    "author": "CBTwise Team <hello@cbtwise.com.ng>",
    "private": true,
    "type": "module",
    "main": "main.js",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "electron:start": "electron .",
        "electron:build": "electron-builder --win",
        "mobile:sync": "cap sync",
        "mobile:open": "cap open android"
    },
    "build": {
        "appId": "com.cbtwise.app",
        "productName": "CBTwise",
        "directories": {
            "output": "dist"
        },
        "files": [
            "main.js",
            ".env",
            "app/**/*",
            "bootstrap/**/*",
            "config/**/*",
            "database/**/*",
            "lang/**/*",
            "public/**/*",
            "resources/views/**/*",
            "routes/**/*",
            "storage/**/*",
            "vendor/**/*",
            "php-win/**/*"
        ],
        "win": {
            "target": [
                "nsis",
                "portable"
            ],
            "icon": "public/icons/icon-512x512.png"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "CBTwise"
        }
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.2",
        "autoprefixer": "^10.4.2",
        "concurrently": "^9.0.1",
        "electron": "^44.2.0",
        "electron-builder": "^26.15.3",
        "laravel-vite-plugin": "^1.0.0",
        "postcss": "^8.4.31",
        "tailwindcss": "^3.4.0",
        "vite": "^5.0.0"
    },
    "dependencies": {
        "@capacitor/android": "^8.5.1",
        "@capacitor/app": "^8.1.1",
        "@capacitor/cli": "^8.5.1",
        "@capacitor/core": "^8.5.1",
        "@capacitor/network": "^8.0.1",
        "@capacitor/splash-screen": "^8.0.2",
        "@capacitor/status-bar": "^8.0.3"
    }
}
