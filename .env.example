APP_NAME=CBTWise
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Africa/Lagos

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cbtwise
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@cbtwise.com.ng"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── Reverb (Self-hosted WebSockets) ───────────────────────────────────────────
REVERB_APP_ID=cbtwise
REVERB_APP_KEY=cbtwise-key
REVERB_APP_SECRET=cbtwise-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ─── Paystack ───────────────────────────────────────────────────────────────────
PAYSTACK_PUBLIC_KEY=pk_test_
PAYSTACK_SECRET_KEY=sk_test_
PAYSTACK_PLAN_MONTHLY=PLN_
PAYSTACK_PLAN_ANNUAL=PLN_
PAYSTACK_PAYMENT_URL=https://api.paystack.co

# ─── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500

# ─── ALOC Questions API ──────────────────────────────────────────────────────────
ALOC_API_TOKEN=
ALOC_API_BASE=https://questions.aloc.com.ng/api/v2
ALOC_TIMEOUT=3
ALOC_RETRY=1

# ─── Google OAuth ────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ─── Tawk.to ─────────────────────────────────────────────────────────────────────
TAWKTO_WIDGET_ID=

# ─── Horizon ─────────────────────────────────────────────────────────────────────
HORIZON_DOMAIN=
HORIZON_PATH=horizon
