{
  "appId": "ng.com.cbtwise.app",
  "appName": "CBTwise",
  "webDir": "public",
  "server": {
    "url": "https://cbtwise.com.ng",
    "cleartext": false,
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#059669",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#059669"
    }
  }
}
